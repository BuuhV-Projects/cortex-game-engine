{
  "name": "cortex-game-engine",
  "version": "0.35.0",
  "type": "module",
  "main": "out/main/index.js",
  "description": "Motor de jogo 3D com ECS, Three.js e integração com Claude AI",
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "build:engine": "tsc -p tsconfig.engine.json && vite build --config vite.engine.config.ts && vite build --config vite.engine.dev.config.ts && vite build --config vite.engine.rapier.config.ts",
    "docs:engine": "typedoc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "electron:dev": "yarn build:engine && yarn docs:engine && electron-vite dev",
    "electron:build": "yarn build:engine && yarn docs:engine && electron-vite build && electron-builder",
    "electron:install": "node --use-system-ca node_modules/electron/install.js",
    "postinstall": "node --use-system-ca node_modules/electron/install.js",
    "build:web": "cd web && yarn install && yarn build && cd ..",
    "reinstall": "rm -rf node_modules yarn.lock && yarn install",
    "dev:web": "cd web && yarn install && yarn dev && cd .."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@anthropic-ai/sdk": "^0.98.0",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "commander": "~14.0.3",
    "three": "~0.184.0",
    "three-mesh-bvh": "0.9.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-block-scoping": "7.29.7",
    "@babel/plugin-transform-classes": "7.28.4",
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/three": "^0.184.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "monaco-editor": "^0.55.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.12",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^4.1.8"
  },
  "resolutions": {
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
