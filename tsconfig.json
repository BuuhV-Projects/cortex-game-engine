{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",

  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts"],
  // monacoModels.test.ts importa código do renderer (electron/), que tem
  // tsconfig próprio (bundler) e não compila sob o NodeNext deste projeto.
  "exclude": ["node_modules", "dist", "tests/electron/monacoModels.test.ts"]
}
