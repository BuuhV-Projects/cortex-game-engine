{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // O build do electron é feito pelo electron-vite (bundle esbuild/rollup,
    // vide electron.vite.config.ts) — este tsconfig serve só pra TYPE-CHECK.
    // Sem rootDir: blender.ts importa de ../../../src/ai legitimamente (fora de
    // electron/), o que o electron-vite resolve no bundle; rootDir só gerava
    // falso TS6059. noEmit porque ninguém consome dist-electron.
    "noEmit": true
  },
  "include": ["main.ts", "preload.ts", "agent/**/*.ts"]
}
