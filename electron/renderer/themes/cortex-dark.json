{
  "name": "cortex-dark",
  "displayName": "Cortex Dark",
  "cssVars": {
    "--od-bg": "#16171d",
    "--od-bg-panel": "#16171d",
    "--od-bg-tab": "#1d1e25",
    "--od-bg-hover": "#26272f",
    "--od-bg-hover-strong": "#30313a",
    "--od-bg-selected": "#1d1e25",
    "--od-bg-deep": "#0d0e14",
    "--od-border": "rgba(255,255,255,0.07)",
    "--od-border-soft": "rgba(255,255,255,0.07)",
    "--od-border-strong": "rgba(255,255,255,0.12)",
    "--od-fg-bright": "#f1f1f4",
    "--od-fg": "#bcbdc3",
    "--od-fg-muted": "#84858d",
    "--od-fg-dim": "#62636a",
    "--od-accent": "#968dfd",
    "--od-accent-hover": "#aaa0ff",
    "--od-cyan": "#00bcc5",
    "--od-green": "#52cd7d",
    "--od-green-dark": "#3db44a",
    "--od-yellow": "#ebbd57",
    "--od-orange": "#e48233",
    "--od-magenta": "#d476cd",
    "--od-red": "#f36164",
    "--od-red-dark": "#b34548",

    "--bg-0": "#0d0e14",
    "--bg-1": "#16171d",
    "--bg-2": "#1d1e25",
    "--bg-3": "#26272f",
    "--bg-4": "#30313a",
    "--line": "rgba(255,255,255,0.07)",
    "--line-2": "rgba(255,255,255,0.12)",
    "--tx-hi": "#f1f1f4",
    "--tx": "#bcbdc3",
    "--tx-lo": "#84858d",
    "--tx-dim": "#62636a",
    "--accent": "#968dfd",
    "--accent-q": "rgba(150,141,253,0.16)",
    "--play": "#52cd7d",
    "--play-q": "rgba(82,205,125,0.16)",
    "--stop": "#f36164",
    "--warn": "#f2b95a",
    "--info": "#3bb9ed",
    "--r": "10px",
    "--r-s": "7px",
    "--r-x": "14px",
    "--ui": "\"Space Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "--mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, monospace"
  },
  "monaco": {
    "base": "vs-dark",
    "inherit": true,
    "rules": [
      { "token": "", "foreground": "bcbdc3", "background": "16171d" },
      { "token": "comment", "foreground": "62636a", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "968dfd" },
      { "token": "keyword.flow", "foreground": "968dfd" },
      { "token": "keyword.json", "foreground": "3bb9ed" },
      { "token": "operator", "foreground": "00bcc5" },
      { "token": "delimiter", "foreground": "bcbdc3" },
      { "token": "string", "foreground": "68ca80" },
      { "token": "string.escape", "foreground": "00bcc5" },
      { "token": "string.invalid", "foreground": "f36164" },
      { "token": "number", "foreground": "e99355" },
      { "token": "regexp", "foreground": "68ca80" },
      { "token": "constant", "foreground": "e99355" },
      { "token": "constant.language", "foreground": "e99355" },
      { "token": "identifier", "foreground": "bcbdc3" },
      { "token": "variable", "foreground": "ed8c84" },
      { "token": "variable.predefined", "foreground": "e99355" },
      { "token": "variable.parameter", "foreground": "e99355" },
      { "token": "variable.readonly", "foreground": "e99355" },
      { "token": "variable.declaration", "foreground": "ed8c84" },
      { "token": "type", "foreground": "ebbd57" },
      { "token": "type.identifier", "foreground": "ebbd57" },
      { "token": "type.declaration", "foreground": "ebbd57" },
      { "token": "class", "foreground": "ebbd57" },
      { "token": "class.declaration", "foreground": "ebbd57" },
      { "token": "class.defaultLibrary", "foreground": "ebbd57" },
      { "token": "interface", "foreground": "ebbd57" },
      { "token": "interface.declaration", "foreground": "ebbd57" },
      { "token": "enum", "foreground": "ebbd57" },
      { "token": "enum.declaration", "foreground": "ebbd57" },
      { "token": "enumMember", "foreground": "e99355" },
      { "token": "function", "foreground": "3bb9ed" },
      { "token": "function.declaration", "foreground": "3bb9ed" },
      { "token": "function.defaultLibrary", "foreground": "3bb9ed" },
      { "token": "method", "foreground": "3bb9ed" },
      { "token": "method.declaration", "foreground": "3bb9ed" },
      { "token": "property", "foreground": "ed8c84" },
      { "token": "property.declaration", "foreground": "ed8c84" },
      { "token": "property.readonly", "foreground": "ed8c84" },
      { "token": "parameter", "foreground": "e99355" },
      { "token": "parameter.declaration", "foreground": "e99355" },
      { "token": "namespace", "foreground": "ebbd57" },
      { "token": "namespace.declaration", "foreground": "ebbd57" },
      { "token": "typeParameter", "foreground": "ebbd57" },
      { "token": "tag", "foreground": "ed8c84" },
      { "token": "tag.id", "foreground": "e99355" },
      { "token": "tag.class", "foreground": "ebbd57" },
      { "token": "attribute.name", "foreground": "e99355" },
      { "token": "attribute.value", "foreground": "68ca80" },
      { "token": "attribute.value.html", "foreground": "68ca80" },
      { "token": "metatag", "foreground": "968dfd" },
      { "token": "metatag.content.html", "foreground": "68ca80" },
      { "token": "metatag.html", "foreground": "968dfd" },
      { "token": "metatag.xml", "foreground": "968dfd" },
      { "token": "string.key.json", "foreground": "ed8c84" },
      { "token": "string.value.json", "foreground": "68ca80" },
      { "token": "attribute.value.number.css", "foreground": "e99355" },
      { "token": "attribute.value.unit.css", "foreground": "e99355" },
      { "token": "attribute.value.hex.css", "foreground": "e99355" }
    ],
    "colors": {
      "editor.background": "#16171d",
      "editor.foreground": "#bcbdc3",
      "editor.lineHighlightBackground": "#1d1e25",
      "editor.lineHighlightBorder": "#1d1e25",
      "editor.selectionBackground": "#30313a",
      "editor.selectionHighlightBackground": "#30313a80",
      "editor.inactiveSelectionBackground": "#30313a80",
      "editor.wordHighlightBackground": "#3a3b4580",
      "editor.findMatchBackground": "#4a3f8a",
      "editor.findMatchHighlightBackground": "#352c66",
      "editorCursor.foreground": "#968dfd",
      "editorWhitespace.foreground": "#30313a",
      "editorIndentGuide.background": "#26272f",
      "editorIndentGuide.activeBackground": "#62636a",
      "editorLineNumber.foreground": "#4a4b53",
      "editorLineNumber.activeForeground": "#bcbdc3",
      "editorGutter.background": "#16171d",
      "editorRuler.foreground": "#26272f",
      "editorBracketMatch.background": "#30313a80",
      "editorBracketMatch.border": "#968dfd",
      "editorOverviewRuler.border": "#16171d",
      "editorWidget.background": "#1d1e25",
      "editorWidget.border": "#0d0e14",
      "editorSuggestWidget.background": "#1d1e25",
      "editorSuggestWidget.border": "#0d0e14",
      "editorSuggestWidget.foreground": "#bcbdc3",
      "editorSuggestWidget.selectedBackground": "#26272f",
      "editorSuggestWidget.highlightForeground": "#968dfd",
      "editorHoverWidget.background": "#1d1e25",
      "editorHoverWidget.border": "#0d0e14",
      "scrollbar.shadow": "#0d0e14",
      "scrollbarSlider.background": "#30313a80",
      "scrollbarSlider.hoverBackground": "#3a3b458a",
      "scrollbarSlider.activeBackground": "#46474fa8",
      "minimap.background": "#16171d",
      "editorError.foreground": "#f36164",
      "editorWarning.foreground": "#f2b95a",
      "editorInfo.foreground": "#3bb9ed"
    }
  }
}
