{
  "appId": "com.cortex.studio",
  "productName": "TS Cortex Studio",
  "directories": {
    "output": "dist-app"
  },
  "files": [
    "out/**"
  ],
  "asarUnpack": [
    "**/node_modules/@anthropic-ai/claude-agent-sdk/**",
    "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
  ],
  "extraResources": [
    { "from": "templates", "to": "templates" },
    { "from": "kits", "to": "kits" },
    { "from": "dist-engine", "to": "dist-engine" },
    {
      "from": "docs/cortex-game-engine/engine-api.md",
      "to": "docs/cortex-game-engine/engine-api.md"
    },
    {
      "from": ".claude",
      "to": "agent-plugin",
      "filter": [".claude-plugin/**", "agents/**", "skills/**"]
    },
    {
      "from": "dist/src",
      "to": "dist/src",
      "filter": ["**/*.d.ts", "**/*.js"]
    },
    {
      "from": "node_modules/@types/three",
      "to": "node_modules/@types/three",
      "filter": ["**/*.d.ts", "package.json"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "extraResources": [
      {
        "from": "native/build",
        "to": "native/build",
        "filter": ["cortex_host.exe", "*.dll", "Roboto-Medium.ttf", "bin/hermesc.exe"]
      },
      {
        "from": "native/build-steam",
        "to": "native/build-steam",
        "filter": ["cortex_host.exe", "*.dll", "Roboto-Medium.ttf", "bin/hermesc.exe"]
      },
      { "from": "native/scripts", "to": "native/scripts" },
      { "from": "native/js", "to": "native/js" },
      {
        "from": "native/tools/basis-encoder",
        "to": "native/tools/basis-encoder",
        "filter": ["basis_encoder.js", "basis_encoder.wasm"]
      },
      {
        "from": "native/third_party/hermes/tools/native/release/x86",
        "to": "native/third_party/hermes/tools/native/release/x86",
        "filter": ["hermes.exe"]
      },
      { "from": "src", "to": "src" },
      { "from": "native/export-toolchain/node_modules", "to": "node_modules" }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ]
  }
}
