{
  "appId": "com.cortex.studio",
  "productName": "Cortex Game Engine Studio",
  "directories": {
    "output": "dist-app"
  },
  "files": [
    "out/**"
  ],
  "extraResources": [
    { "from": "templates", "to": "templates" },
    { "from": "dist-engine", "to": "dist-engine" },
    {
      "from": "docs/cortex-game-engine/engine-api.md",
      "to": "docs/cortex-game-engine/engine-api.md"
    },
    {
      "from": "dist/src",
      "to": "dist/src",
      "filter": ["**/*.d.ts", "**/*.js"]
    },
    {
      "from": "node_modules/@types/three",
      "to": "node_modules/@types/three",
      "filter": ["**/*.d.ts", "package.json"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ]
  }
}
