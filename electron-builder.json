{
  "appId": "com.cortex.studio",
  "productName": "Cortex Game Engine Studio",
  "directories": {
    "output": "dist-app"
  },
  "files": [
    "out/**",
    "templates/**",
    "dist-engine/**",
    "dist/src/**/*.d.ts",
    "node_modules/@types/three/**/*.d.ts",
    "node_modules/@types/three/package.json"
  ],
  "asarUnpack": [
    "templates/**",
    "dist-engine/**",
    "dist/src/**/*.d.ts"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ]
  }
}
