# Dependencies
node_modules/

# Build output
dist/
dist-engine/
build/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
# Local History (extensão do VSCode) — versões locais de arquivos, nunca versionar
.history/

# Vitest / coverage
coverage/
.vitest/

# Temporary files (Blender script generation)
tmp/
*.tmp.py
out/
dist-app/

# Benchmark (M-perf-1 / ADR-0135): saída de export e histórico local (fps é
# específico da máquina) — não versionar.
examples/*/dist-native/
examples/*/.cortex-cache/
native/bench-history.jsonl
# Assets .glb do bench (pesados, ~40 MB cada) — gerados por prepare-assets.mjs.
examples/bench-city/assets/
dist-native/*
# Worktrees de trabalho vivem sob .claude/ (que agora tambem e o plugin cortex-studio,
# ADR-0180) — nao versionar nem deixar um `git add .claude` arrasta-las.
.claude/worktrees/
