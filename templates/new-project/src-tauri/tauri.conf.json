{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{PROJECT_NAME}}",
  "version": "0.0.1",
  "identifier": "com.cortex-game.{{PROJECT_NAME}}",
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "{{PROJECT_NAME}}",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "fullscreen": true,
        "decorations": false,
        "additionalBrowserArgs": "--ignore-gpu-blocklist --enable-zero-copy --enable-features=Vulkan,UseSkiaRenderer --disable-features=msSmartScreenProtection --use-angle=d3d11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
