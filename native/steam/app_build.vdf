// SteamPipe — script de build/upload do app pra Steam (usado pelo steamcmd).
// TEMPLATE: troque APPID/DEPOTID pelos seus (aparecem no Steamworks ao criar o
// app + o depot). ContentRoot aponta pro dist-native gerado por:
//   node native/scripts/export-game.mjs <gameDir> --steam
//
// Subir (com o steamcmd, logado na conta de parceiro):
//   steamcmd +login <usuario> +run_app_build <caminho absoluto deste vdf> +quit
//
// Cada upload vira um "build" no Steamworks → você seleciona/publica num branch
// (ex.: default) pelo painel. Não commite IDs reais aqui se o repo for público.
"AppBuild"
{
	"AppID"       "YOUR_APP_ID"
	"Desc"        "Cute Obstacle Rush — build"

	// Pasta com o jogo pronto (saída do export --steam). Ajuste o caminho.
	"ContentRoot" "..\..\..\..\..\jogos\teste4\dist-native"
	"BuildOutput" ".\steam_build_output\"

	"Depots"
	{
		"YOUR_DEPOT_ID"
		{
			"FileMapping"
			{
				"LocalPath"  "*"
				"DepotPath"  "."
				"recursive"  "1"
			}
		}
	}
}
